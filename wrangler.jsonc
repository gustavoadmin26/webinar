{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webinar",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/painel/api/*",
      "/conteudo",
      "/eventos/*",
      "/ir/*"
    ]
  },
  "main": "worker.mjs",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
